{
  "name": "iiro.fi",
  "version": "34.35.0",
  "private": true,
  "description": "A static site",
  "homepage": "https://iiro.fi",
  "license": "MIT",
  "author": "Iiro Jäppinen <iiro@jappinen.fi> (https://iiro.fi)",
  "repository": {
    "type": "git+https",
    "url": "https://github.com/iiroj/iiro.fi"
  },
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "start": "wrangler dev",
    "lint": "oxfmt && oxlint",
    "build": "node --import ./oxc-loader.ts build.tsx",
    "version": "commit-and-tag-version --sign --noBumpWhenEmptyChanges",
    "deploy": " wrangler deploy"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "commit-and-tag-version": "13.3.0",
    "husky": "9.1.7",
    "lint-staged.sh": "0.6.9",
    "oxc-transform": "0.158.0",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2006",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "schema-dts": "2.1.0",
    "tinyexec": "1.3.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "onFail": "error"
    }
  }
}
