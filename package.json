{
  "name": "iiro.fi",
  "version": "34.29.0",
  "private": true,
  "description": "A static site",
  "homepage": "https://iiro.fi",
  "license": "MIT",
  "author": "Iiro Jäppinen <iiro@jappinen.fi> (https://iiro.fi)",
  "repository": {
    "type": "git+https",
    "url": "https://github.com/iiroj/iiro.fi"
  },
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "start": "node --import ./oxc-loader.ts --watch build.tsx",
    "lint": "oxfmt && oxlint",
    "build": "node --import ./oxc-loader.ts build.tsx",
    "version": "commit-and-tag-version --sign --noBumpWhenEmptyChanges",
    "deploy": "node ./deploy.ts"
  },
  "devDependencies": {
    "@atproto/api": "0.20.42",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/serve-handler": "6.1.4",
    "commit-and-tag-version": "13.1.2",
    "husky": "9.1.7",
    "lint-staged.sh": "0.6.9",
    "oxc-transform": "0.147.0",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "schema-dts": "2.0.0",
    "serve-handler": "6.1.7",
    "tinyexec": "1.3.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "onFail": "error"
    }
  }
}
