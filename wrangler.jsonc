{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "assets": {
    "directory": "./public",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
  },
  "name": "site",
  "compatibility_date": "2026-10-06",
  "preview_urls": false,
  "routes": [
    {
      "pattern": "iiro.fi",
      "custom_domain": true,
    },
  ],
  "send_metrics": false,
  "workers_dev": false,
}
